# ==========================================
# Mazhai Vaanam Boutique — Backend Config Example
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/mazhaivaanam

# Client / Frontend URLs (CORS Allowlist)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=60m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRE=7d

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# AWS S3 / Cloudflare R2 Cloud Storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=mazhaivaanam
AWS_S3_PUBLIC_URL=https://mazhaivaanam.s3.ap-south-1.amazonaws.com

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
